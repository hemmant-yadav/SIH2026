{
  "name": "messmind",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*",
    "packages/*",
    "infra/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev:frontend": "npm run --workspace=@messmind/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
